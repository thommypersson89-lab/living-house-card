{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src", "demo/*.ts", "tests", "playwright.config.ts"]
}
